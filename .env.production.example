# Configuración para producción (docker-compose.prod.yml)
# Copiar este archivo a .env y editar los valores.

# Imágenes (GHCR)
# CI publica:
#   ghcr.io/<owner>/<repo>-api:main y :<sha>
#   ghcr.io/<owner>/<repo>-web:main y :<sha>
API_IMAGE=ghcr.io/OWNER/REPO-api
WEB_IMAGE=ghcr.io/OWNER/REPO-web
IMAGE_TAG=main

# PostgreSQL
POSTGRES_USER=terrahaus
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=terrahaus

# API
JWT_SECRET=CAMBIAR_POR_JWT_SECRET_SEGURO
CORS_ORIGIN=*

# (Opcional) Traefik override
DOMAIN=terrahaus.es
API_DOMAIN=api.terrahaus.es
